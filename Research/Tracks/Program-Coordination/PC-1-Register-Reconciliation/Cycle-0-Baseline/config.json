  "pc4_coverage": "../../PC-4-Research-to-Domain-Map/Cycle-x12/iter-2/data/coverage_domains.csv",
  "pc4_tog24": "../../PC-4-Research-to-Domain-Map/judgments/tog24_x12.csv",
  "suite_path": "/workspace/coord/zip/gaia_totality_suite_v0_1",
  "expected_mismatches": [
    "GAIA-TOT-024",
    "GAIA-TOT-025",
    "GAIA-TOT-035",
    "GAIA-TOT-038"
  ],
  "boundary_window": 80,
  "iterations": {
    "1": {
      "home_rule": "as_judged"
