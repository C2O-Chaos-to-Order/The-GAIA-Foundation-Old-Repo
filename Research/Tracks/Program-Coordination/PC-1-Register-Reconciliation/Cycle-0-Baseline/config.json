      "metric": "id_collisions",
      "op": "eq",
      "threshold": 0
    },
    {
      "id": "C0-8",
      "hypothesis": "Every audit v2 item is mapped to at least one domain",
      "metric": "audit_unmapped",
      "op": "eq",
      "threshold": 0
    },
    {
      "id": "C0-9",
      "hypothesis": "Adoption boundary: no file in the PC-1 folder shares an 80-character window with any suite file",
      "metric": "boundary_overlaps",
      "op": "eq",
      "threshold": 0
    }
  ]
