  },
  "checks": [
    {
      "id": "C0-1",
      "hypothesis": "Exactly one row for each of the 45 register domains",
      "metric": "domain_rows_ok",
      "op": "eq",
      "threshold": 45
    },
    {
      "id": "C0-2",
      "hypothesis": "Every row passes integrity (labels, owner equals the register's decision authority, reviewer roles from ToG 7.1 or specialist, valid UR domains, valid home paths)",
      "metric": "problems",
      "op": "eq",
      "threshold": 0
    },
    {
      "id": "C0-3",
      "hypothesis": "Every cited anchor (file#text) resolves in this branch",
      "metric": "anchors_unresolved",
      "op": "eq",
      "threshold": 0
    },
    {
      "id": "C0-4",
      "hypothesis": "Recomputing b9 from the suite's crosswalk rows gives exactly the 11 domains the Work Queue lists",
      "metric": "b9_symmetric_difference",
      "op": "eq",
      "threshold": 0
    },
    {
      "id": "C0-5",
