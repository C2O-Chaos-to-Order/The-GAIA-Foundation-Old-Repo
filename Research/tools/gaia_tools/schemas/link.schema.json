{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/KyleAlexanderSteen/The-GAIA-Foundation/Research/tools/gaia_tools/schemas/link.schema.json",
 "title": "Cross-report link (data model 1.1.0)",
 "description": "One row of Report-7-Unified/maps/link_register.csv; basis is split on ';'. Cycle-specific columns use the prefix c<N>_.",
 "type": "object",
 "required": [
  "link_id",
  "from",
  "to",
  "link_type",
  "statement",
  "framework_label",
  "basis",
  "test",
  "rejection_criterion",
  "gaia_thread"
 ],
 "properties": {
  "link_id": {
   "type": "string",
   "pattern": "^L[0-9]{2}$"
  },
  "from": {
   "type": "string",
   "pattern": "^R[1-7] (Body|Mind|Soul|Spirit|Consciousness|Earth|Unified)$"
  },
  "to": {
   "type": "string",
   "pattern": "^(R[1-7] (Body|Mind|Soul|Spirit|Consciousness|Earth|Unified)|All)$"
  },
  "link_type": {
   "enum": [
    "relationship",
    "distinction",
    "dependency",
    "feedback loop",
    "competing interpretation",
    "unresolved question",
    "humans within Earth"
   ]
  },
  "statement": {
   "type": "string",
   "minLength": 10
  },
  "framework_label": {
   "enum": [
    "Established",
    "Plausible",
    "Philosophical/Spiritual",
    "Hypothetical"
   ]
  },
  "basis": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^(C0v2|C[1-9][0-9]*)-R[1-7]-[0-9]{2}$"
   }
  },
  "test": {
   "type": "string",
   "minLength": 5
  },
  "rejection_criterion": {
   "type": "string",
   "minLength": 1,
   "description": "Required for Plausible/Hypothetical links (checked by the Report-7 J1 check). A dash placeholder is reported as quality warning Q3."
  },
  "gaia_thread": {
   "type": "string",
   "minLength": 5
  }
 },
 "patternProperties": {
  "^c[0-9]+_(evidence|sim_checks|literature_test|status|change)$": {
   "type": "string"
  }
 },
 "additionalProperties": false
}
